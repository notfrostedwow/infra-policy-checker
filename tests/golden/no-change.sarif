{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "properties": {
        "coverage": {
          "addresses_suppressed_for_sensitivity": false,
          "by_rule": {
            "AWS-ENC-001": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            },
            "AWS-ENC-002": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            },
            "AWS-IAM-001": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            },
            "AWS-IAM-002": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            },
            "AWS-NET-001": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            },
            "AWS-S3-001": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            },
            "IPC-COVERAGE": {
              "FAIL": 0,
              "PASS": 0,
              "SKIP": 0,
              "UNKNOWN": 0
            }
          },
          "deferred_resources": 0,
          "no_supported_checks": true,
          "outcomes": {
            "FAIL": 0,
            "PASS": 0,
            "SKIP": 0,
            "UNKNOWN": 0
          },
          "plan_completeness": "complete",
          "plan_errored": false,
          "skip_reasons": {},
          "skipped_resources": 0,
          "supported_checks": 0,
          "supported_resources": 0,
          "total_resources": 0,
          "unresolved": true
        },
        "exitCode": 3,
        "failOn": "medium",
        "scope": "Selected planned AWS settings only; no cloud or effective IAM verification."
      },
      "results": [],
      "tool": {
        "driver": {
          "name": "infra-policy-checker",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Planned ingress permits unrestricted SSH or RDP; reachability is unassessed."
              },
              "id": "AWS-NET-001",
              "properties": {
                "severity": "high"
              },
              "shortDescription": {
                "text": "Review unrestricted remote administration ingress"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An explicit S3 public access block setting is false; effective exposure is unassessed."
              },
              "id": "AWS-S3-001",
              "properties": {
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Require four explicit S3 public access blocks"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Explicit EBS encryption policy is unmet; defaults and inheritance are unassessed."
              },
              "id": "AWS-ENC-001",
              "properties": {
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Require explicit EBS encryption"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Explicit RDS storage encryption policy is unmet; live storage is unassessed."
              },
              "id": "AWS-ENC-002",
              "properties": {
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Require explicit RDS storage encryption"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An Allow action contains wildcard syntax; effective permissions are unassessed."
              },
              "id": "AWS-IAM-001",
              "properties": {
                "severity": "high"
              },
              "shortDescription": {
                "text": "Review Allow wildcard action syntax"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An Allow resource is exactly \"*\"; some AWS actions require this scope."
              },
              "id": "AWS-IAM-002",
              "properties": {
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Review Allow universal resource syntax"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Resource was not evaluated by a supported policy."
              },
              "id": "IPC-COVERAGE",
              "properties": {
                "severity": "note"
              },
              "shortDescription": {
                "text": "Report bounded review coverage"
              }
            }
          ],
          "version": "1.0.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
