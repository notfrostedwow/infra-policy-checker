              },
              "id": "AWS-ENC-002",
              "properties": {
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Require explicit RDS storage encryption"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "An Allow action contains wildcard syntax; effective permissions are unassessed."
              },
              "id": "AWS-IAM-001",
              "properties": {
                "severity": "high"
              },
              "shortDescription": {
                "text": "Review Allow wildcard action syntax"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "An Allow resource is exactly \"*\"; some AWS actions require this scope."
              },
              "id": "AWS-IAM-002",
              "properties": {
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Review Allow universal resource syntax"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "Resource was not evaluated by a supported policy."
              },
              "id": "IPC-COVERAGE",
              "properties": {
                "severity": "note"
              },
              "shortDescription": {
                "text": "Report bounded review coverage"
              }
